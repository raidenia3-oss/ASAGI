<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.asagi.brain">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:hasCode="true">
        <receiver android:name=".BridgeEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="asagi.brain.event" />
            </intent-filter>
        </receiver>

        <receiver android:name=".DownloadProgressReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="asagi.brain.download.progress" />
            </intent-filter>
        </receiver>

        <!-- Servicio de Accesibilidad: lo activa el usuario en Ajustes. Permite a
             ASAGI leer la pantalla y, con aprobacion, tocar/escribir en otras apps. -->
        <service
            android:name=".AsagiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
