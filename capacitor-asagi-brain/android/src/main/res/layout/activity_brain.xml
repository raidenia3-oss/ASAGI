<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brain_download_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_title"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/brain_download_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_description"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/brain_download_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/brain_download_recommend_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/download_recommend"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@android:color/holo_blue_light" />

                <Button
                    android:id="@+id/brain_download_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_now"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/brain_download_later"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_later"
                    android:layout_marginEnd="8dp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/brain_download_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/brain_download_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_progress"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/brain_download_retries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/brain_download_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_cancel"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/brain_download_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_retry" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/brain_download_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:visibility="gone">

                <Button
                    android:id="@+id/brain_download_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_confirm_wifi"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/brain_download_cellular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_confirm_cellular"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Formulario principal (aplicación) -->
    <include
        android:id="@+id/brain_download_form"
        layout="@layout/activity_brain_form" />

    <!-- Fragmento independiente: formulario de descarga -->
    <include
        android:id="@+id/brain_download_form_later"
        layout="@layout/activity_brain_form_later" />
</LinearLayout>
